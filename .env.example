# --- Required -------------------------------------------------------------------------
# Spotify developer app (https://developer.spotify.com/dashboard). The app owner needs Spotify Premium.
# Redirect URI must be exactly: http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Google Gemini, free tier (https://aistudio.google.com/apikey): reads posters, judges same-name bands
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# --- Strongly recommended (free) -----------------------------------------------------------
# Cities that count as "local" (semicolon-separated). The poster's city is always added.
LOCAL_CITIES=Provo, UT; Orem, UT; Salt Lake City, UT; Ogden, UT

# Tavily web search (https://tavily.com, 1,000 free searches/month, no card): finds tiny bands' pages
TAVILY_API_KEY=

# Last.fm (https://www.last.fm/api/account/create): extra listener counts / top songs
LASTFM_API_KEY=

# Your email or a URL, sent to MusicBrainz and OpenStreetMap as contact info (their usage policies ask for it)
MUSICBRAINZ_CONTACT=

# --- Optional -----------------------------------------------------------------------------
# Instagram account with a saved login (see README) so bands' bio links can be read
IG_USERNAME=

# Paid alternative to Gemini (use with --claude)
# ANTHROPIC_API_KEY=
# FESTIFY_MODEL=claude-sonnet-5-5
# FESTIFY_FAST_MODEL=claude-haiku-4-5-20251001
