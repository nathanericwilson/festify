# Spotify developer app (owner needs Premium; redirect URI http://127.0.0.1:8888/callback)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Anthropic (poster reading, disambiguation, web search)
ANTHROPIC_API_KEY=
# FESTIFY_MODEL=claude-sonnet-5-5            # reads posters
# FESTIFY_FAST_MODEL=claude-haiku-4-5-20251001 # same-name judging + web search (cheap)

# Last.fm (free key: https://www.last.fm/api/account/create) - secondary song/listener source
LASTFM_API_KEY=

# Optional: Instagram username with a saved instaloader session (run: instaloader -l <username>)
IG_USERNAME=

# Where "local" is when a poster doesn't say a city
HOME_REGION=Utah, Salt Lake City, Provo

# MusicBrainz asks for contact info in the User-Agent (email or URL)
# MUSICBRAINZ_CONTACT=you@example.com
